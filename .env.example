# Global dotfiles configuration — single source of truth for all setup scripts.
#
# On the first install, install.sh copies this file to .env. The real .env is
# gitignored; this .env.example template is tracked. Edit .env with your values.
#
# Bash-sourceable: KEY="value" (quote values containing spaces).

# --- Git identity ------------------------------------------------------------
GIT_NAME="Your Name"
GIT_EMAIL="you@example.com"
GIT_EDITOR="vim"
GIT_DEFAULT_BRANCH="master"

# --- SSH ---------------------------------------------------------------------
SSH_KEY_TYPE="ed25519"
SSH_KEY_COMMENT=""        # empty -> falls back to GIT_EMAIL
